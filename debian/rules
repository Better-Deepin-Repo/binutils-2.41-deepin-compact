#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export BFD_SOVER_EXT = -system
export CTF_SOVER_EXT =

BUILDDIR := builddir
LIBDIR := usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_configure:
	@if ! grep -q 'BFD_SOVER_EXT' bfd/Makefile.in; then \
		echo "error: debian/patches/135_bfd_soversion.patch is not applied." >&2; \
		echo "       Build through dpkg-buildpackage, which applies debian/patches/series." >&2; \
		exit 1; \
	fi
	rm -rf $(BUILDDIR)
	mkdir -p $(BUILDDIR)
	cd $(BUILDDIR) && ../configure \
		--build=$(DEB_BUILD_GNU_TYPE) \
		--host=$(DEB_HOST_GNU_TYPE) \
		--prefix=/usr \
		--libdir=/$(LIBDIR) \
		--enable-shared \
		--disable-static \
		--disable-nls \
		--disable-werror \
		--disable-gold \
		--disable-gprofng \
		--with-system-zlib

override_dh_auto_build:
	$(MAKE) -C $(BUILDDIR) -j$(shell nproc) all-libsframe
	$(MAKE) -C $(BUILDDIR) -j$(shell nproc) all-bfd
	$(MAKE) -C $(BUILDDIR) -j$(shell nproc) all-opcodes

override_dh_auto_test:

override_dh_auto_install:
	install -D -m0644 $(BUILDDIR)/bfd/.libs/libbfd-2.41-system.so \
		debian/tmp/$(LIBDIR)/libbfd-2.41-system.so
	install -D -m0644 $(BUILDDIR)/opcodes/.libs/libopcodes-2.41-system.so \
		debian/tmp/$(LIBDIR)/libopcodes-2.41-system.so
	install -D -m0644 $(BUILDDIR)/libsframe/.libs/libsframe.so.1.0.0 \
		debian/tmp/$(LIBDIR)/libsframe.so.1.0.0
	ln -s libsframe.so.1.0.0 debian/tmp/$(LIBDIR)/libsframe.so.1
	chrpath -d debian/tmp/$(LIBDIR)/libbfd-2.41-system.so
	chrpath -d debian/tmp/$(LIBDIR)/libopcodes-2.41-system.so

override_dh_auto_clean:
	rm -rf $(BUILDDIR)

override_dh_update_autotools_config:

override_dh_autoreconf:

override_dh_installchangelogs:
	dh_installchangelogs -XChangeLog -XChangeLog.git

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:
